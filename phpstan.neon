includes:
	- vendor/rdx/db/extension.neon
	- phpstan-baseline.neon
parameters:
	level: 6
	bootstrapFiles:
		- phpstan.php
	typeAliases:
		AssocArray: 'array<string, mixed>'
	paths:
		- ./
		# - src/
	excludePaths:
		- vendor/
	dynamicConstantNames:
		- ADMIN_IPS
		- IMDB_SEARCH_URL
		- PATHE_DOWNLOAD_TTL
		- PATHE_OBJECT_STORE
		- PATHE_OBJECT_STORE_URL
	rdx_dbfw:
		aroPropertiesSchemaFile: 'inc.db-schema.php'
	treatPhpDocTypesAsCertain: false
	checkFunctionNameCase: true
	checkNullables: true
	# checkExplicitMixed: true
	# checkImplicitMixed: true
	reportMaybes: true
	reportUnmatchedIgnoredErrors: true
	ignoreErrors:
		- message: "#^Method .+::relate_\\w+\\(\\) has no return type specified#"
